{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nakade",
  "compatibility_date": "2026-11-01",
  // /api/* runs the API (worker.js → apps/api/src/worker.js). Everything else is the static SPA:
  // Vite builds into dist/, unknown paths fall back to index.html so React Router can handle them.
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  // Daily cleanup of sessions unused for 180 days (worker.js → scheduled). Inherited by env.dev.
  "triggers": { "crons": ["17 3 * * *"] },
  // production: deployed from main by Workers Builds (`npx wrangler deploy`)
  "routes": [
    { "pattern": "nakade.app", "custom_domain": true },
    { "pattern": "www.nakade.app", "custom_domain": true },
  ],
  // BEFORE THE FIRST RELEASE: production needs its own D1, or /api/* answers 503 and the site shows nothing.
  //   npx wrangler d1 create nakade   → paste the database_id it prints into the line below, then uncomment it.
  // "d1_databases": [{ "binding": "DB", "database_name": "nakade", "database_id": "<from wrangler d1 create>" }],
  // 120 API requests per minute per IP. namespace_id is any account-unique integer.
  "ratelimits": [{ "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }],
  "env": {
    // dev: deployed from dev by Workers Builds (`npx wrangler deploy --env dev`).
    // noindex for dev.nakade.app is set in public/_headers.
    "dev": {
      "name": "nakade-dev",
      "routes": [{ "pattern": "dev.nakade.app", "custom_domain": true }],
      // Anonymous sessions (profile, swipes). Settlements are bundled JSON, so no DB credentials exist.
      "d1_databases": [{ "binding": "DB", "database_name": "nakade-dev", "database_id": "211b508e-58c6-4fce-b322-aa6eadd0b191" }],
      // 120 API requests per minute per IP. namespace_id is any account-unique integer.
      "ratelimits": [{ "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
    },
  },
}
