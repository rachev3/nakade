# Cloudflare Workers static-asset headers (https://developers.cloudflare.com/workers/static-assets/headers/)

# Keep the dev environment out of search engines.
https://dev.nakade.app/*
  X-Robots-Tag: noindex

# The MSW worker must always be fresh, or an old mock script can linger after an update.
/mockServiceWorker.js
  Cache-Control: no-cache

# The hackathon presentation stays reachable by link but out of search results.
/presentation/*
  X-Robots-Tag: noindex
